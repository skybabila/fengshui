# Supabase Configuration
# Get these values from your Supabase project settings

# From: Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# From: Project Settings → API → Project API keys (anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# From: Project Settings → API → Legacy anon, service_role API keys (service_role)
# IMPORTANT: Use the legacy key that starts with "eyJ..."
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Site URL (for email confirmation links)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# AI API Configuration
# AI provider base URL (e.g., OpenAI: https://api.openai.com/v1, or compatible APIs)
NEXT_PUBLIC_AI_BASE_URL=https://api.openai.com/v1

# AI API key
NEXT_PUBLIC_AI_API_KEY=your-ai-api-key-here

# AI model name (default: gpt-3.5-turbo)
NEXT_PUBLIC_AI_MODEL=gpt-3.5-turbo
